{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "데스크톱 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.desktoppet",
    "productName": "Desktop Pet",
